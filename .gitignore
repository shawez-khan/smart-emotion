# ─────────────────────────────────────────────────────────
#  EmotiLearn — Root .gitignore
# ─────────────────────────────────────────────────────────

# ── SECRETS & CREDENTIALS (NEVER COMMIT) ──
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
!.env.example
!**/.env.example

# ── PYTHON VIRTUAL ENVIRONMENTS & CACHES ──
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
**/__pycache__/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
.pytest_cache/
.mypy_cache/

# ── DATASETS (Large raw training data; keep out of git) ──
dataset/
dataset/**

# ── ML MODEL CHECKPOINTS & ARTIFACTS ──
# Transient checkpoints and pickle caches
backend/models/*.pkl
backend/models/*.ckpt
# Keep the production FER2013-trained CNN model and visualization curves:
!backend/models/emotion_cnn_fer2013.h5
!backend/models/training_curves.png

# ── NODE / FRONTEND ──
node_modules/
**/node_modules/
frontend/client/build/
frontend/client/.pnp
frontend/client/.pnp.js
frontend/client/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS & IDE ARTIFACTS ──
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
Microsoft/
*.swp
*.swo
*~
