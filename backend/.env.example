# EmotiLearn Backend — Environment Configuration Template
# Copy this file to .env and configure for your environment.
# SECURITY WARNING: NEVER commit .env with real secrets to version control!

# Environment mode: 'development' or 'production'
# In production, JWT_SECRET is strictly required and HSTS headers are enabled.
FLASK_ENV=development

# Server host & port
HOST=127.0.0.1
PORT=5000

# Set to 1 only during local development debugging (NEVER enable in production)
FLASK_DEBUG=0

# Allowed CORS origins (comma-separated, without trailing slashes)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT signing secret (Required in production)
# Generate a secure 64-character hex key using:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_CHAR_HEX_STRING

# Secret key required to register or claim an admin/instructor account
ADMIN_REGISTRATION_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_ADMIN_KEY

# MongoDB connection string (local or MongoDB Atlas cluster)
MONGO_URI=mongodb://localhost:27017

# Path to trained CNN emotion recognition model file
MODEL_PATH=models/emotion_cnn_fer2013.h5
